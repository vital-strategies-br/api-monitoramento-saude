# Environment template for the server stack (docker-compose.yml).
#
# Release: copy to .env on the server and replace every <...> placeholder.
#   cp .env.example .env
# Never commit .env. API keys and secrets travel through a secure channel,
# never by email (spec section 10).
#
# Values below are the production settings from the Alert Plugin Final
# Specification. Lines marked "dev:" give the training (dev) server value.

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=monitoramento_saude
# Host the API and Flyway connect to. `db` is the container in docker-compose.yml;
# point it to the RDS endpoint when the database moves out of the container.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host port the `db` container is published on
POSTGRES_HOST_PORT=5432

# Connection pool per worker process
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Seconds to wait for a free connection
DATABASE_POOL_TIMEOUT=60

# =============================================================================
# Application
# =============================================================================
# prod | dev. prod also turns HMAC on when REQUIRE_HMAC is empty.
ENV=prod
# Gunicorn worker processes. The rate limit counts per worker (see below).
GUNICORN_WORKERS=2

# =============================================================================
# Authentication (spec 10)
# =============================================================================
# Comma-separated API keys accepted in X-API-Key
API_KEYS=<api-key>
# HMAC-SHA256 secret for X-Signature
API_SECRET=<hmac-secret>
# HMAC is required in both environments (spec 10)
REQUIRE_HMAC=true
# Maximum clock difference for X-Timestamp, in seconds
TIMESTAMP_TOLERANCE_SECONDS=300

# Origin verification: on in production, only for the plugin extensions.
# dev: ENFORCE_ORIGIN_CHECK=false
ENFORCE_ORIGIN_CHECK=true
# Comma-separated allowed origins, e.g. chrome-extension://<extension-id>
ALLOWED_ORIGINS=<chrome-extension://plugin-extension-id>

# =============================================================================
# Telemetry - POST /api/v1/telemetria/eventos (spec 8.6)
# =============================================================================
# Events per call. Contract value agreed with Pitang: change only together with them.
TELEMETRY_MAX_BATCH_SIZE=200

# =============================================================================
# Request limits (all authenticated routes)
# =============================================================================
# Maximum body size in bytes (1 MiB). A reverse proxy in front of the API needs
# a limit at least this large (nginx: client_max_body_size).
MAX_REQUEST_BODY_BYTES=1048576

# Per-IP rate limit. Go-live order (README, "Limits and configuration"):
#   1. put the Pitang backend outbound IP in RATE_LIMIT_EXEMPT_IPS
#   2. confirm FORWARDED_ALLOW_IPS resolves real client IPs
#   3. set RATE_LIMIT_ENABLED=true
# Effective ceiling = RATE_LIMIT_REQUESTS x GUNICORN_WORKERS.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated client IPs never rate limited
RATE_LIMIT_EXEMPT_IPS=<pitang-backend-outbound-ip>

# Proxies whose X-Forwarded-For header is trusted for the client IP (read by
# gunicorn). List the reverse proxy / load balancer IP when there is one,
# otherwise every client appears as the proxy and shares one rate-limit counter.
FORWARDED_ALLOW_IPS=127.0.0.1

# =============================================================================
# Local development only (docker-compose.local.yml) - not used on the server
# =============================================================================
# SQLAlchemy URL; on the server it is built from POSTGRES_* in docker-compose.yml.
# URL-encode special characters in the password ('%' -> '%25').
# DATABASE_URL=postgresql+psycopg://<user>:<password>@host.docker.internal:5432/monitoramento_saude
# Password of the linkage user in the ATTACH line of scripts/exportar_parquet.sql
# LINKAGE_PGPASSWORD=<linkage-password>
# Local port of an SSH tunnel to the linkage database, if ATTACH uses one
# LINKAGE_TUNNEL_PORT=
# true = include the two fictitious smoke-test people in the export
# INCLUIR_LINHAS_TESTE=false
